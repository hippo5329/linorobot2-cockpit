# ==============================================================================
# Secrets Template for Linorobot2 Cockpit
# Copy this file to secrets.yaml (gitignored) and populate your credentials.
# ==============================================================================

wifi:
  ssid: "YOUR_WIFI_SSID"
  password: "YOUR_WIFI_PASSWORD"
  static_ip: ""           # Blank for DHCP, or e.g. "192.168.1.50"
  gateway: ""
  subnet: "255.255.255.0"
  dns: "8.8.8.8"

micro_ros:
  agent_ip: "192.168.1.100"
  agent_port: 8888

telemetry:
  syslog_server: "192.168.1.100"
  syslog_port: 5140
  ota_port: 3232

