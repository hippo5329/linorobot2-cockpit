diff --git a/modules/libmicroros/CMakeLists.txt b/modules/libmicroros/CMakeLists.txt
index 4e8c213..887d171 100644
--- a/modules/libmicroros/CMakeLists.txt
+++ b/modules/libmicroros/CMakeLists.txt
@@ -22,12 +22,17 @@ zephyr_get_system_include_directories_for_lang_as_string(CXX system_includes_cxx
 zephyr_get_compile_definitions_for_lang_as_string(       CXX definitions_cxx)
 zephyr_get_compile_options_for_lang_as_string(           CXX options_cxx)
 
+# Zephyr 4.4 + picolibc (SDK 1.0): rcutils asks for C11 Annex K (__STDC_WANT_LIB_EXT1__),
+# picolibc's string.h then names __errno_t / __rsize_t, but the include path finds
+# Zephyr's sys/_types.h, which does not define them. rcutils only asks when the macro
+# is undefined and never uses Annex K here (picolibc has no __STDC_LIB_EXT1__), so say no.
+set(annex_k_types "-D__STDC_WANT_LIB_EXT1__=0 -D_DEFAULT_SOURCE -I/work/compat -include /work/compat/uros_compat.h")
 set(external_project_cflags
-    "${includes} ${definitions} ${options} ${system_includes}"
+    "${includes} ${definitions} ${options} ${system_includes} ${annex_k_types}"
     )
 
 set(external_project_cxxflags
-    "${includes_cxx} ${definitions_cxx} ${options_cxx} ${system_includes_cxx}"
+    "${includes_cxx} ${definitions_cxx} ${options_cxx} ${system_includes_cxx} ${annex_k_types}"
     )
 
 include(ExternalProject)
@@ -56,6 +61,11 @@ zephyr_link_libraries(${MICROROS_DIR}/libmicroros.a)
 
 zephyr_interface_library_named(microros)
 add_dependencies(microros libmicroros_project)
+# The external build compiles rcutils against the POSIX headers Zephyr provides
+# (filesystem.c: sys/stat.h, dirent.h, unistd.h). They include zephyr/syscall.h and so
+# the GENERATED syscall_list.h, and nothing made this build wait for it: ninja ran the
+# two side by side, and a loaded build failed "zephyr/syscall_list.h: No such file".
+add_dependencies(libmicroros_project zephyr_generated_headers ${SYSCALL_LIST_H_TARGET})
 target_include_directories(microros INTERFACE ${MICROROS_DIR}/include)
 
 execute_process(
